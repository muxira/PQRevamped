{
  "id": "./",
  "name": "Party Quiz Companion",
  "short_name": "Party Quiz",
  "description": "Unofficial Party Quiz companion: join a game, customize your avatar in 2D or 3D, answer, bid and appeal from your phone.",
  "start_url": "./core/templates/game.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "background_color": "#f1ebf8",
  "theme_color": "#7b3fe4",
  "lang": "en",
  "dir": "auto",
  "categories": ["games", "entertainment"],
  "icons": [
    {
      "src": "assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Join a game",
      "short_name": "Join",
      "url": "./core/templates/game.html",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
